{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/PLAN.md"],
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push origin main*": "deny",
      "git branch -D*": "deny",
      "git tag*": "deny",
      "git remote*": "ask",
      "git reset --hard*": "ask",
      "rm -rf*": "ask",
      "gh release*": "deny",
      "gh pr merge*": "deny"
    }
  }
}
